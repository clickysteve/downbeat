{
  "name": "downbeat",
  "version": "0.1.0",
  "private": true,
  "description": "DOWNBEAT: an intelligent rhythm machine for the browser, inspired by Intelligent Music's UpBeat.",
  "homepage": "https://downbeat.allmyfriendsaresynths.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/clickysteve/downbeat.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@slopfactory/core": "github:clickysteve/slopfactory-core#07f14f050569964082c8c9b390c9221f4373b6c3"
  }
}
